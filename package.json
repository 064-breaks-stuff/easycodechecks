{
  "name": "easycodechecks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run validate:content && react-router build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview --outDir build/client",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-router/node": "^7.9.2",
    "@react-three/fiber": "^9.3.0",
    "animejs": "^4.1.3",
    "isbot": "^5.1.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router": "^7.9.2",
    "three": "^0.180.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
